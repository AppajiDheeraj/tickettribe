
generator client {
  provider = "prisma-client-js"
  output = ""
}

datasource db {
  provider = "postgresql"
}
model User{
  id       Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  points    Int      @default(0)
  predictions Prediction[]
  tribes    Tribe[]  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prediction{
  id        Int      @id @default(autoincrement())
  AAPL      Boolean
  MSFT      Boolean
  GOOGL     Boolean
  userId    Int
  date      DateTime 
  locked    Boolean    @default(false) 
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Tribe{
  id      Int      @id @default(autoincrement())
  code    String   @unique
  members User[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
